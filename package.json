{
  "name": "gc-app",
  "version": "0.0.1",
  "description": "Getaway Collective · 10-Wave Constitutional Build",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && npm run lint:vocab",
    "lint:vocab": "node scripts/vocab-lint.js",
    "lint:ufr": "node scripts/ufr-lint.js",
    "tokens": "node scripts/export-tokens.js",
    "verify": "npm run lint:vocab && npm run lint:ufr && npm run tokens && npm run type-check",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "next": "^15.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "vitest": "^1.0.0",
    "@testing-library/react": "^14.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
