{
  "name": "gc-app",
  "version": "0.0.1",
  "description": "Getaway Collective \u00b7 10-Wave Constitutional Build",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && npm run lint:vocab",
    "lint:vocab": "node scripts/vocab-lint.js",
    "lint:ufr": "node scripts/ufr-lint.js",
    "lint:rel": "node scripts/rel-lint.js",
    "tokens": "node scripts/export-tokens.js",
    "schemas": "node scripts/gen-schemas.js",
    "schemas:check": "node scripts/gen-schemas.js --check",
    "verify": "npm run lint:vocab && npm run lint:ufr && npm run lint:rel && npm run schemas:check && npm run db:check && npm run fixtures:check && npm run tokens && npm run type-check && npm run test:run",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "db:schema": "node scripts/gen-db.js",
    "db:check": "node scripts/gen-db.js --check",
    "fixtures": "node scripts/gen-fixtures.js",
    "fixtures:check": "node scripts/gen-fixtures.js --check",
    "test:run": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
