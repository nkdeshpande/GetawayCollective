# Getaway Collective — environment.
# Copy to .env.local for local work. Set the same keys in Vercel's
# dashboard for preview and production. .env.local is gitignored; this
# file is committed and must never contain a real secret.

# The canonical origin. Used by sitemap.ts, robots.ts and metadataBase,
# so a wrong value here puts the wrong domain in every share card and
# every sitemap URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://getawaycollective.co

# Resend — the two public lead forms. Without this key both endpoints
# return 503 and the forms say so on the page; they never claim a
# message was sent when it was not. See lib/leads.ts.
RESEND_API_KEY=
# Must be a domain verified in Resend. Until one is, Resend's sandbox
# sender works and only delivers to your own account address.
RESEND_FROM="Getaway Collective <onboarding@resend.dev>"

# Where the two forms deliver. Both default to addresses on the
# getawaycollective.co domain if unset.
SIGNAL_LEAD_EMAIL=
DOSSIER_LEAD_EMAIL=

# ── Not wired yet ────────────────────────────────────────────────────
# Nothing in the application reads these. They are listed so the shape
# of the next integration is visible, and so nobody invents a different
# name for them later.
# DATABASE_URL=            # Neon. drizzle.config.ts already reads it.
# CLERK_SECRET_KEY=        # Clerk. resolveSubject() is unimplemented.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# RAZORPAY_KEY_ID=         # Razorpay. No payment code exists.
# RAZORPAY_KEY_SECRET=
