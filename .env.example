# Getaway Collective — environment.
# Copy to .env.local for local work. Set the same keys in Vercel's
# dashboard for preview and production. .env.local is gitignored; this
# file is committed and must never contain a real secret.

# The canonical origin. Used by sitemap.ts, robots.ts and metadataBase,
# so a wrong value here puts the wrong domain in every share card and
# every sitemap URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://getawaycollective.co

# Resend — the two public lead forms. Without this key both endpoints
# return 503 and the forms say so on the page; they never claim a
# message was sent when it was not. See lib/leads.ts.
RESEND_API_KEY=
# The sending identity. MUST be on a domain verified in Resend.
#
# getawaycollective.co was verified on 03 Aug 2026 (GoDaddy DNS, DKIM +
# SPF, region ap-northeast-1), so a Getaway Collective address works and
# reaches any recipient.
#
# Before a domain is verified, Resend accepts only its sandbox sender
# (onboarding@resend.dev) and delivers ONLY to the account owner's own
# address — every other recipient is rejected outright with a validation
# error. That is worth knowing because it fails at send time, not at
# configuration time: everything looks wired until the first real
# recipient never receives anything.
#
# notices@ rather than hello@ deliberately. hello@, ir@ and press@ are
# published on /contact and read by people; mixing automated notices into
# a human inbox buries the human mail. Whatever is used here must still
# accept replies or carry a Reply-To — somebody WILL reply to a
# distribution notice asking what it means, and a bounce is a bad answer.
RESEND_FROM="Getaway Collective <notices@getawaycollective.co>"

# Where the two forms deliver. Both default to addresses on the
# getawaycollective.co domain if unset.
SIGNAL_LEAD_EMAIL=
DOSSIER_LEAD_EMAIL=

# ── Authentication (Auth.js v5) ──────────────────────────────────────
# Sign the session cookie. Generate with: npx auth secret
# Without it, every sign-in fails and everybody stays anonymous.
AUTH_SECRET=

# Google OAuth. Create at console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application. The redirect URI must
# be exactly, for each origin you deploy to:
#   http://localhost:3000/api/auth/callback/google
#   https://getawaycollective.co/api/auth/callback/google
# Leave both blank and the Google button disappears from /sign-in rather
# than appearing and failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres. Required for the EMAIL magic link — a verification token has
# to be written down before it can be checked. Google sign-in works
# without it, because an OAuth handshake with a JWT session needs no
# adapter. Apply migrations with: npx drizzle-kit migrate
DATABASE_URL=

# The one-time authority bootstrap. authority.grant is itself a right, so
# an empty grant table can never issue the first grant and the Office
# stays unreachable forever. This mints ONE enterprise grant for a listed
# address the first time it signs in, names itself as grantor, and never
# re-grants an identity that already has a row.
#   Format: email:role,email:role
#   Roles come from lib/authority.ts — board, investment_committee,
#   audit_risk_committee, governance_ethics_committee, executive_office,
#   governance_office, compliance_office, member
# Remove it once real grants exist. Manage them with scripts/grant.mjs.
GC_OFFICE_BOOTSTRAP=

# ── Rate limiting (G-10) ─────────────────────────────────────────────
# Upstash Redis, REST API. Create at console.upstash.com — the free tier
# covers this volume comfortably. Copy the REST url and token, not the
# redis:// connection string.
#
# Without these the limiter falls back to a per-instance in-memory
# counter, which on serverless means the effective ceiling is multiplied
# by however many instances are warm. The two public lead endpoints are
# the only unauthenticated write paths in the system, so set these before
# the forms are reachable from the open internet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Not wired yet ────────────────────────────────────────────────────
# Nothing in the application reads these. They are listed so the shape
# of the next integration is visible, and so nobody invents a different
# name for them later.
# RAZORPAY_KEY_ID=         # Razorpay. No payment code exists.
# RAZORPAY_KEY_SECRET=
